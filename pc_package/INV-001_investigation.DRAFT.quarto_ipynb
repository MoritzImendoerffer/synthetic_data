      "source": [
        "---\n",
        "title: \"Investigation Report\"\n",
        "subtitle: \"A-Mab Drug Substance — INV-001\"   # instantiate as \"A-Mab Drug Substance — <UO_TITLE> — <DOC>\", or\n",
        "                          # as \"A-Mab Drug Substance — <DOC>\" for a corpus-level document,\n",
        "                          # whose UO_TITLE IS \"A-Mab Drug Substance\" and would otherwise\n",
        "                          # render twice (found 2026-08-21 across all four of batch B5).\n",
        "author: \"Quality Assurance (QA)\"\n",
        "date: 2026-09-18\n",
        "format:\n",
        "  docx:\n",
        "    reference-doc: reference.docx\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    number-sections: true\n",
        "    fig-cap-location: bottom\n",
        "    tbl-cap-location: top\n",
        "  pdf:\n",
        "    documentclass: scrreprt\n",
        "    mainfont: \"DejaVu Serif\"\n",
        "    sansfont: \"DejaVu Sans\"\n",
        "    monofont: \"DejaVu Sans Mono\"\n",
        "    mathfont: \"DejaVu Math TeX Gyre\"\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    number-sections: true\n",
        "    colorlinks: true\n",
        "    geometry: margin=1in\n",
        "    fig-pos: 'H'\n",
        "    fig-cap-location: bottom\n",
        "    tbl-cap-location: top\n",
        "    include-in-header: _tables.tex   # multirow, booktabs, threeparttable for complex tables\n",
        "bibliography: references.bib\n",
        "execute:\n",
        "  echo: false\n",
        "  warning: false\n",
        "  cache: false\n",
        "jupyter: python3\n",
        "---"
      ],
      "id": "c6ed76dc"
    },
    {
      "cell_type": "code",
      "metadata": {
        "tags": [
          "setup"
        ]
      },
      "source": [
        "import sys, os\n",
        "sys.path.insert(0, os.path.abspath(\".\"))\n",
        "from _pcpkg import *  # noqa: F401,F403\n",
        "import doe_report as D\n",
        "import tables as T          # complex tables: merged cells, footnotes (T.<builder>(...).show())\n",
        "import matplotlib.pyplot as plt\n",
        "import scipy.stats as sstat\n",
        "import itertools\n",
        "\n",
        "DOC = \"INV-001\"\n",
        "UO = None\n",
        "# The investigation judged every NOR as it stood when it closed: the characterized NOR, before\n",
        "# PCR-005 and PCR-006 Version 2.0 narrowed two of them. Every NOR-based value below is computed\n",
        "# inside this context; it is closed at the end of the setup chunk.\n",
        "_CN = D.characterized_nor()\n",
        "_CN.__enter__()\n",
        "UO_TITLE = \"A-Mab Drug Substance\"\n",
        "\n",
        "# --- doc-local derived scalars (pulled from config -> model -> outputs; nothing typed) ---\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def f1(x): return f\"{x:.1f}\"\n",
        "def md(df, widths=None):\n",
        "    \"\"\"Print a flat table with the cells exactly as formatted; widths are relative column widths.\"\"\"\n",
        "    cols = list(df.columns)\n",
        "    out = [\"| \" + \" | \".join(str(c) for c in cols) + \" |\"]\n",
        "    w = widths or [max(3, len(str(c))) for c in cols]\n",
        "    out.append(\"|\" + \"|\".join(\"-\" * int(x) for x in w) + \"|\")\n",
        "    for row in df.astype(str).values.tolist():\n",
        "        out.append(\"| \" + \" | \".join(row) + \" |\")\n",
        "    print(\"\\n\".join(out))\n",
        "def f2(x): return f\"{x:.2f}\"\n",
        "def big(x): return f\"{x:,.0f}\"\n",
        "def lc(s): return s if (len(s) > 1 and s[1].isupper()) or s.startswith(\"Protein A\") else s[0].lower() + s[1:]\n",
        "def attr(c): return T.ATTR_NAME[c].split(\" (\")[0]\n",
        "def aname(c):\n",
        "    \"\"\"An attribute as prose names it: 'host cell protein', 'fragments', 'XMuLV clearance'.\"\"\"\n",
        "    return lc(attr(c).split(\",\")[0])\n",
        "def sname(k): return lc(T.STEP_NAME[k])\n",
        "_NW = [\"no\", \"one\", \"two\", \"three\", \"four\", \"five\", \"six\", \"seven\", \"eight\", \"nine\", \"ten\"]\n",
        "def nw(n): return _NW[n] if 0 <= n < len(_NW) else str(n)\n",
        "def unit(c): return T.ATTR_NAME[c].split(\"(\")[-1].rstrip(\")\")\n",
        "def _in(v, lo, hi, st):\n",
        "    return (v >= lo) if st == \"lower\" else (v <= hi) if st == \"upper\" else (lo <= v <= hi)\n",
        "\n",
        "OPENED, CLOSED = INV[\"opened\"], INV[\"closed\"]\n",
        "REV1_DATE, REV2_DATE = REV1[\"effective\"], REV2[\"effective\"]\n",
        "DOC_V, DOC_EFF = doc_version(DOC)\n",
        "n_docs_v1 = len([d for d in DOC_REGISTRY if d != DOC])\n",
        "# the investigation closed before PCMP-001 Version 2.0 took effect\n",
        "assert CLOSED < REV2_DATE\n",
        "\n",
        "# chronology: the studies Version 1.0 reported are every study except those of the plan\n",
        "# discrepancy PD-005-01 (S-PA-SDM2), which ran during the investigation\n",
        "chron = csv(\"study_chronology.csv\")\n",
        "_st = chron.set_index(\"id\")\n",
        "_pd = [d for d in PLAN_DISCREPANCIES.get(\"PCR-005\", []) if d.get(\"studies\")]\n",
        "assert len(_pd) == 1\n",
        "pd_id, pd_studies = _pd[0][\"id\"], list(_pd[0][\"studies\"])\n",
        "assert len(pd_studies) == 1\n",
        "sdm2_id = pd_studies[0]\n",
        "chron_v1 = chron[~chron[\"id\"].isin(pd_studies)]\n",
        "n_studies_v1 = len(chron_v1)\n",
        "assert bool((chron_v1[\"end\"] < REV1_DATE).all())          # every Version 1.0 study closed before approval\n",
        "first_start, last_end = chron_v1[\"start\"].min(), chron_v1[\"end\"].max()\n",
        "sdm2_start, sdm2_end = _st.loc[sdm2_id, [\"start\", \"end\"]]\n",
        "assert OPENED <= sdm2_start and sdm2_end <= CLOSED          # S-PA-SDM2 ran during the investigation\n",
        "\n",
        "# the supplementary scale-down runs: a discrepancy from the plan, not a deviation\n",
        "_sdmq = csv(\"sdm_qualification.csv\")\n",
        "_sdmq = _sdmq[(_sdmq[\"step\"] == \"protein_a\") & (_sdmq[\"scale\"] == \"scale-down\")]\n",
        "_sdm_planned_ids = [s for s in _sdmq[\"study\"].unique() if s != sdm2_id]\n",
        "n_sdm_planned = int(_sdmq[\"study\"].isin(_sdm_planned_ids).sum())\n",
        "n_sdm_sup = int((_sdmq[\"study\"] == sdm2_id).sum())\n",
        "sdm1_id = _sdm_planned_ids[0]\n",
        "OFF_CI = int(round(100 * CFG.raw()[\"analytics\"][\"sdm\"][\"offset_ci\"]))\n",
        "_hcpq_all = D.offset_qualification(\"protein_a\", \"pool_hcp_ng_mg\")\n",
        "_hcpq_plan = D.offset_qualification(\"protein_a\", \"pool_hcp_ng_mg\", studies=_sdm_planned_ids)\n",
        "pa_hcp_same_concl = bool(_hcpq_plan[\"qualified\"] and _hcpq_all[\"qualified\"]\n",
        "                         and _hcpq_plan[\"met_point\"] == _hcpq_all[\"met_point\"])\n",
        "pa_hcp_half_plan, pa_hcp_half_all = _hcpq_plan[\"half\"], _hcpq_all[\"half\"]\n",
        "assert pa_hcp_half_all < pa_hcp_half_plan                    # the extra runs narrowed the interval\n",
        "sdm_concl_phrase = (\"The qualification conclusion is the same on the planned runs alone.\"\n",
        "                    if pa_hcp_same_concl else\n",
        "                    \"The qualification conclusion differs on the planned runs alone, and PCR-005 states how.\")\n",
        "\n",
        "frc_start, frc_end = _st.loc[\"S-CEX-FRC\", \"start\"], _st.loc[\"S-CEX-FRC\", \"end\"]\n",
        "ret_start, ret_end = _st.loc[\"S-PA-RET\", \"start\"], _st.loc[\"S-PA-RET\", \"end\"]\n",
        "aexr_start = _st.loc[\"S-AEX-SCR\", \"start\"]\n",
        "cexr_start, cexr_end = _st.loc[\"S-CEX-RSM\", \"start\"], _st.loc[\"S-CEX-RSM\", \"end\"]\n",
        "assert cexr_start < AMD[\"date\"] < cexr_end and aexr_start > AMD[\"date\"] and ret_start > AMD[\"date\"]\n",
        "\n",
        "# Version 1.0 criteria\n",
        "r1 = D.rev1_criteria()\n",
        "n_r1 = len(r1)\n",
        "n_r1_steps = r1[\"step_key\"].nunique()\n",
        "RV1 = CFG.raw()[\"rev1_ipc_limits\"]\n",
        "sigma = RV1[\"capability_alert_sigma\"]\n",
        "v_allow = RV1[\"viral_assay_allowance\"]\n",
        "_mg = r1.dropna(subset=[\"margin\"])\n",
        "n_margin = len(_mg)\n",
        "m_lo, m_hi = _mg[\"margin\"].min(), _mg[\"margin\"].max()\n",
        "n_capbased = int((r1[\"rule\"] == \"mean + 2.5 sd of capability\").sum())\n",
        "assert set(r1[r1[\"rule\"] == \"mean + 2.5 sd of capability\"][\"step_key\"]) == {\"bioreactor\"}\n",
        "n_viral_r1 = int(r1[\"cqa\"].str.startswith(\"lrv\").sum())\n",
        "n_viral_req = int((r1[\"rule\"] == \"requirement - nominal of other steps\").sum())\n",
        "n_viral_claim = int(r1[\"rule\"].str.startswith(\"nominal claim\").sum())\n",
        "\n",
        "def _r1(key, resp):\n",
        "    return r1[(r1[\"step_key\"] == key) & (r1[\"response\"] == resp)].iloc[0]\n",
        "\n",
        "pa_hcp = _r1(\"protein_a\", \"pool_hcp_ng_mg\")\n",
        "pa_hcp_crit, pa_hcp_margin = pa_hcp[\"high\"], pa_hcp[\"margin\"]\n",
        "cex_agg = _r1(\"cex\", \"aggregate_out_pct\")\n",
        "cex_agg_crit, cex_agg_margin = cex_agg[\"high\"], cex_agg[\"margin\"]\n",
        "_iac = D.iac_table()\n",
        "def _ds(cqa, col):\n",
        "    return _iac[_iac[\"cqa\"] == cqa].iloc[0][col]\n",
        "ds_hcp = _ds(\"hcp\", \"ds_high\")\n",
        "ds_agg = _ds(\"aggregates_hmw\", \"ds_high\")\n",
        "ds_acid_lo, ds_acid_hi = _ds(\"acidic_variants\", \"ds_low\"), _ds(\"acidic_variants\", \"ds_high\")\n",
        "ds_frag = _ds(\"fragments_lmw\", \"ds_high\")\n",
        "\n",
        "# §3.2: no part of the Protein A characterization range meets the drug-substance HCP criterion\n",
        "_uo_pa = CFG.unit_op(\"protein_a\")\n",
        "_fpa = D.fit(\"protein_a\", \"rsm\", \"pool_hcp_ng_mg\")[\"factors\"]\n",
        "_gpa = list(itertools.product(*[[_uo_pa.param(f).prange[0], _uo_pa.param(f).setpoint,\n",
        "                                 _uo_pa.param(f).prange[1]] for f in _fpa]))\n",
        "_ypa = D.predict(\"protein_a\", \"pool_hcp_ng_mg\", natural={f: [g[i] for g in _gpa] for i, f in enumerate(_fpa)})\n",
        "assert float(np.min(_ypa)) - D.sdm_offset(\"protein_a\", \"pool_hcp_ng_mg\")[\"offset\"] > ds_hcp\n",
        "\n",
        "# F2: what each safety factor did at the set-point of its own step\n",
        "def _setpoint_pred(key, resp):\n",
        "    fs = D.rsm_factors(key)\n",
        "    sp = {f: CFG.unit_op(key).param(f).setpoint for f in fs}\n",
        "    return float(D.predict(key, resp, natural=sp)[0])\n",
        "\n",
        "_rows = []\n",
        "for _, r in _mg.iterrows():\n",
        "    pred = _setpoint_pred(r[\"step_key\"], r[\"response\"])\n",
        "    ceiling = r[\"high\"] * r[\"margin\"]\n",
        "    _rows.append(dict(step=r[\"step_key\"], cqa=r[\"cqa\"], margin=r[\"margin\"], crit=r[\"high\"],\n",
        "                      pred=pred, ceiling=ceiling, maxf=ceiling / pred))\n",
        "margin_df = pd.DataFrame(_rows)\n",
        "n_pass_sp = int((margin_df[\"pred\"] <= margin_df[\"crit\"]).sum())\n",
        "assert n_pass_sp == n_margin                                  # the summary says every step passed\n",
        "n_fail_uniform = int((margin_df[\"maxf\"] < m_hi).sum())\n",
        "margin_show = pd.DataFrame({\n",
        "    \"Step\": [T.STEP_NAME[s] for s in margin_df[\"step\"]],\n",
        "    \"Attribute\": [T.ATTR_NAME[c] for c in margin_df[\"cqa\"]],\n",
        "    \"Highest level downstream steps bring to specification\": [T.num(x) for x in margin_df[\"ceiling\"]],\n",
        "    \"Safety factor\": [f1(x) for x in margin_df[\"margin\"]],\n",
        "    \"Version 1.0 criterion\": [f\"≤ {T.num(x)}\" for x in margin_df[\"crit\"]],\n",
        "    \"Predicted at set-point\": [T.num(x) for x in margin_df[\"pred\"]],\n",
        "    \"Largest factor met at set-point\": [f2(x) for x in margin_df[\"maxf\"]],\n",
        "})\n",
        "\n",
        "# F3: capability-based limits\n",
        "capdf = csv(\"capability.csv\").set_index(\"key\")\n",
        "_cap_rows = []\n",
        "for _, r in r1[r1[\"rule\"] == \"mean + 2.5 sd of capability\"].iterrows():\n",
        "    c = capdf.loc[r[\"cqa\"]]\n",
        "    _cap_rows.append([T.ATTR_NAME[r[\"cqa\"]], f\"{c['mean']:.2f}\", f\"{c['sd']:.3f}\",\n",
        "                      f\"{c['mean'] + sigma * c['sd']:.2f}\", f\"{r['high']:.2f}\",\n",
        "                      T.crit(c[\"acc_low\"], c[\"acc_high\"], \"two_sided\")])\n",
        "    assert f\"{c['mean'] + sigma * c['sd']:.2f}\" == f\"{r['high']:.2f}\"\n",
        "cap_show = pd.DataFrame(_cap_rows, columns=[\n",
        "    \"Attribute\", \"Capability mean\", \"Capability SD\", f\"Mean + {sigma:g} SD\",\n",
        "    \"Version 1.0 upper criterion\", \"Drug-substance criterion\"])\n",
        "exceed_pct = 100 * sstat.norm.sf(sigma)\n",
        "\n",
        "# F4 and the capability change\n",
        "acid = capdf.loc[\"acidic_variants\"]\n",
        "acid_cpu, acid_cpl, acid_cpk = acid[\"Cpu\"], acid[\"Cpl\"], acid[\"Cpk\"]\n",
        "acid_mean, acid_sd = acid[\"mean\"], acid[\"sd\"]\n",
        "assert acid_cpl < acid_cpu and acid_cpk == acid_cpl          # the lower end governs\n",
        "_v1keys = [k for k in capdf.index if k != \"fragments_lmw\"]\n",
        "_v1cpk = pd.Series({k: (capdf.loc[k, \"Cpu\"] if k == \"acidic_variants\" else capdf.loc[k, \"Cpk\"])\n",
        "                    for k in _v1keys})\n",
        "v1_min_cpk, v1_min_key = _v1cpk.min(), _v1cpk.idxmin()\n",
        "v1_min_name = aname(v1_min_key)\n",
        "v2_min_cpk = V[\"min_cpk\"]\n",
        "assert capdf[\"Cpk\"].idxmin() == \"acidic_variants\"\n",
        "poos = D.p_oos().set_index(\"key\")\n",
        "acid_noos, n_mc = int(poos.loc[\"acidic_variants\", \"n_oos\"]), int(poos.loc[\"acidic_variants\", \"n\"])\n",
        "acid_ppm = poos.loc[\"acidic_variants\", \"ppm_normal\"]\n",
        "n_noos_other = int(poos.drop(index=\"acidic_variants\")[\"n_oos\"].sum())\n",
        "assert acid_noos > 0\n",
        "noos_phrase = (f\"one batch in {n_mc:,}\" if acid_noos == 1 else f\"{acid_noos} batches in {n_mc:,}\")\n",
        "other_oos_phrase = (\"No simulated batch falls outside the criterion of any other attribute.\"\n",
        "                    if n_noos_other == 0 else\n",
        "                    f\"For the other attributes together, {n_noos_other} simulated batches fall outside their criteria.\")\n",
        "\n",
        "# F5: plan approval dates and equipment calibration against the execution windows\n",
        "PCP_OF = {\"PCP-003\": \"bioreactor\", \"PCP-004\": \"harvest\", \"PCP-005\": \"protein_a\",\n",
        "          \"PCP-006\": \"viral_inactivation\", \"PCP-007\": \"cex\", \"PCP-008\": \"aex\",\n",
        "          \"PCP-009\": \"virus_filtration\", \"PCP-010\": \"ufdf\"}\n",
        "_pl = []\n",
        "for pid, key in PCP_OF.items():\n",
        "    first = chron[chron[\"step\"] == key][\"start\"].min()\n",
        "    _pl.append([pid, T.STEP_NAME[key], PLAN_APPROVAL[pid], first, REV1_DATE])\n",
        "plan_show = pd.DataFrame(_pl, columns=[\"Plan\", \"Step\", \"Approved\", \"First study started\",\n",
        "                                       \"Date in Version 1.0 title block\"])\n",
        "assert all(r[2] < r[3] for r in _pl)                          # every plan approved before its studies\n",
        "assert all(r[3] < r[4] for r in _pl)                          # every title-block date after the first study\n",
        "pa_appr, pa_first = PLAN_APPROVAL[\"PCP-005\"], chron[chron[\"step\"] == \"protein_a\"][\"start\"].min()\n",
        "pcmp_appr = PLAN_APPROVAL[\"PCMP-001\"]\n",
        "\n",
        "eq = equipment_df()\n",
        "n_eq = len(eq)\n",
        "n_eq_before_rev1 = int((eq[\"Next calibration due\"] < REV1_DATE).sum())\n",
        "due_phrase = (\"Every one of these due dates precedes the date in the title blocks.\"\n",
        "              if n_eq_before_rev1 == n_eq else\n",
        "              f\"Of these due dates, {n_eq_before_rev1} precede the date in the title blocks.\")\n",
        "cw = T.calibration_windows_data()\n",
        "n_cw_studies, n_cw_eq = len(cw), cw[\"Equipment\"].nunique()\n",
        "assert bool((cw[\"Execution end\"] < cw[\"Next calibration due\"]).all())   # no study ran out of calibration\n",
        "_cwm = (pd.to_datetime(cw[\"Next calibration due\"]) - pd.to_datetime(cw[\"Execution end\"])).dt.days\n",
        "_cwn = cw.loc[_cwm.idxmin()]\n",
        "cw_near_study, cw_near_end, cw_near_due = _cwn[\"Study\"], _cwn[\"Execution end\"], _cwn[\"Next calibration due\"]\n",
        "cw_near_eq, cw_near_desc = _cwn[\"Equipment\"], lc(_cwn[\"Description\"])\n",
        "cw_near_step = sname(_st.loc[cw_near_study, \"step\"])\n",
        "cw_near_days = int(_cwm.min())\n",
        "\n",
        "# F6: SEC against nrCE-SDS (S-CEX-FRC), sample means\n",
        "cmp = csv(\"cex_fraction_comparability.csv\").groupby(\"sample\", sort=False)[\n",
        "    [\"lmw_sec_pct\", \"lmw_cesds_pct\", \"difference\"]].mean()\n",
        "d_pa, d_vi, d_load = (cmp.loc[s, \"difference\"] for s in [\"Protein A pool\", \"VI pool\", \"CEX load\"])\n",
        "sec_pa, ce_pa = cmp.loc[\"Protein A pool\", \"lmw_sec_pct\"], cmp.loc[\"Protein A pool\", \"lmw_cesds_pct\"]\n",
        "d_up_lo = min(d_pa, d_vi, d_load); d_up_hi = max(d_pa, d_vi, d_load)\n",
        "d_dn_abs = cmp.loc[[\"CEX pool\", \"AEX pool\"], \"difference\"].abs().max()\n",
        "assert d_up_lo > 0 and d_dn_abs < d_up_lo\n",
        "d_pa_share = 100 * d_pa / ce_pa\n",
        "\n",
        "# Version 2.0 criteria and the verification\n",
        "n_iac = len(_iac)\n",
        "n_iac_ds = int((_iac[\"basis\"] == \"drug substance\").sum())\n",
        "n_iac_claim = int((_iac[\"basis\"] == \"platform claim\").sum())\n",
        "n_iac_back = n_iac - n_iac_ds - n_iac_claim\n",
        "_is_t = _iac[\"tightened\"].astype(str).eq(\"True\")\n",
        "_is_w = _iac[\"widened\"].astype(str).eq(\"True\")\n",
        "n_tight, n_wid = int(_is_t.sum()), int(_is_w.sum())\n",
        "_tt = _iac[_is_t]\n",
        "tight_steps = \" and \".join(sname(s) for s in _tt[\"step_key\"])\n",
        "assert set(_tt[\"cqa\"]) == {\"aggregates_hmw\"}\n",
        "_ww = _iac[_is_w]\n",
        "_wl = [f\"{aname(c)} at the {sname(s)} step\" for s, c in zip(_ww[\"step_key\"], _ww[\"cqa\"])]\n",
        "wid_list = \", \".join(_wl[:-1]) + \" and \" + _wl[-1] if len(_wl) > 1 else \"\".join(_wl)\n",
        "ver = D.iac_verification()\n",
        "_vt = ver[ver[\"met\"].notna()]\n",
        "n_ver = len(_vt)\n",
        "n_ver_met = int((_vt[\"met\"] == 1).sum())\n",
        "n_ver_wsup = int(((_vt[\"met\"] == 1) & (_vt[\"widening_supported\"] == 1)).sum())\n",
        "n_ver_nt = int(ver[\"met\"].isna().sum())\n",
        "assert n_ver - n_ver_met == 1                                 # \"One assumption was not confirmed\"\n",
        "_vx = ver[ver[\"met\"] == 0].iloc[0]\n",
        "assert (_vx[\"step_key\"], _vx[\"cqa\"]) == (\"cex\", \"aggregates_hmw\")\n",
        "cex_agg_assumed, cex_agg_nor, cex_agg_edge = _vx[\"assumed\"], _vx[\"predicted_nor\"], _vx[\"observed_edge\"]\n",
        "# a changed criterion moves only on the data of a step downstream of the one it judges\n",
        "for _, r in _iac[_is_t | _is_w].iterrows():\n",
        "    _dn = ver[(ver[\"step\"] > r[\"step\"]) & (ver[\"cqa\"] == r[\"cqa\"])\n",
        "              & ((ver[\"met\"] == 0) | (ver[\"widening_supported\"] == 1))]\n",
        "    assert len(_dn) > 0, (r[\"step_key\"], r[\"cqa\"])\n",
        "vc = csv(\"iac_viral_cumulative.csv\").set_index(\"cqa\")\n",
        "xm_sum, xm_req = vc.loc[\"lrv_xmulv\", \"claimed_sum\"], vc.loc[\"lrv_xmulv\", \"required\"]\n",
        "mvm_sum, mvm_req = vc.loc[\"lrv_mvm\", \"claimed_sum\"], vc.loc[\"lrv_mvm\", \"required\"]\n",
        "assert xm_sum >= xm_req and mvm_sum >= mvm_req\n",
        "cex_ds_agg_v2 = D.iac_limit(\"cex\", \"aggregate_out_pct\")[1]\n",
        "\n",
        "# host cell protein at cation exchange and anion exchange, and the Protein A criterion they set\n",
        "_vh = ver[(ver[\"step_key\"] == \"cex\") & (ver[\"cqa\"] == \"hcp\")].iloc[0]\n",
        "_va = ver[(ver[\"step_key\"] == \"aex\") & (ver[\"cqa\"] == \"hcp\")].iloc[0]\n",
        "cex_hcp_assumed, cex_hcp_edge, cex_hcp_nor = _vh[\"assumed\"], _vh[\"observed_edge\"], _vh[\"predicted_nor\"]\n",
        "cex_hcp_bound = _vh[\"predicted_nor_bound95\"]\n",
        "aex_hcp_assumed, aex_hcp_bound = _va[\"assumed\"], _va[\"predicted_nor_bound95\"]\n",
        "assert cex_hcp_edge < cex_hcp_assumed <= cex_hcp_bound <= cex_hcp_nor\n",
        "assert bool(_vh[\"widening_supported\"]) and aex_hcp_bound > aex_hcp_assumed\n",
        "aex_hcp_widened = bool(_va[\"widening_supported\"])\n",
        "assert aex_hcp_widened or _va[\"model_adequate\"] is False or str(_va[\"model_adequate\"]) == \"False\"\n",
        "aex_hcp_gap = float(_va[\"r2_minus_pred_r2\"])\n",
        "MAX_GAP, LOF_ALPHA = THRESHOLDS[\"max_r2_minus_pred_r2\"], THRESHOLDS[\"lof_alpha\"]\n",
        "_better = ((_vt[\"assumption\"] == \"fold_min\") & (_vt[\"predicted_nor_bound95\"] > _vt[\"assumed\"])) | \\\n",
        "          ((_vt[\"assumption\"] == \"add_max\") & (_vt[\"predicted_nor_bound95\"] < _vt[\"assumed\"]))\n",
        "aex_hcp_txt = (f\"The 95 % bound for host cell protein at anion exchange, {aex_hcp_bound:.2f}-fold, is also better than the platform value of {aex_hcp_assumed:.1f}-fold, and the criterion upstream was recalculated with it too.\"\n",
        "               if aex_hcp_widened else\n",
        "               f\"The 95 % bound for host cell protein at anion exchange, {aex_hcp_bound:.2f}-fold, is also better than the platform value of {aex_hcp_assumed:.1f}-fold. The anion exchange model fails the adequacy test, with R² less predicted R² of {aex_hcp_gap:.2f}, so the platform value stands for that step.\")\n",
        "n_ver_better_inadequate = int((_better & (_vt[\"met\"] == 1) & ~_vt[\"widening_supported\"].astype(bool)).sum())\n",
        "_pah = _iac[(_iac[\"step_key\"] == \"protein_a\") & (_iac[\"cqa\"] == \"hcp\")].iloc[0]\n",
        "pa_hcp_apriori, pa_hcp_v2 = _pah[\"iac_high_apriori\"], _pah[\"iac_high\"]\n",
        "assert str(_pah[\"widened\"]) == \"True\" and pa_hcp_v2 > pa_hcp_apriori > pa_hcp_crit\n",
        "\n",
        "# PAR (NOR) entries, Version 1.0 against Version 2.0, per report\n",
        "PCR_OF = {\"bioreactor\": \"PCR-003\", \"protein_a\": \"PCR-005\", \"viral_inactivation\": \"PCR-006\",\n",
        "          \"cex\": \"PCR-007\", \"aex\": \"PCR-008\", \"virus_filtration\": \"PCR-009\"}\n",
        "\n",
        "def _span(s):\n",
        "    try:\n",
        "        a, b = str(s).split(\"–\")\n",
        "        return float(a), float(b)\n",
        "    except ValueError:\n",
        "        return None\n",
        "\n",
        "def _par_changes(key):\n",
        "    a, b = D.par_table_rev1(key), D.par_table(key)\n",
        "    m = b.merge(a[[\"CQA\", \"Parameter\", \"PAR (NOR)\"]], on=[\"CQA\", \"Parameter\"], how=\"left\",\n",
        "                suffixes=(\"\", \"_v1\"))\n",
        "    return m\n",
        "\n",
        "def _kind(old, new):\n",
        "    if pd.isna(old):\n",
        "        return \"new\"\n",
        "    if str(new).startswith(\"none\"):\n",
        "        return \"none\"\n",
        "    if str(old) == str(new):\n",
        "        return \"same\"\n",
        "    o, n = _span(old), _span(new)\n",
        "    if o and n and n[0] <= o[0] and n[1] >= o[1]:\n",
        "        return \"wider\"\n",
        "    if o and n and n[0] >= o[0] and n[1] <= o[1]:\n",
        "        return \"narrower\"\n",
        "    return \"shifted\"\n",
        "\n",
        "_allpar = []\n",
        "for k in PCR_OF:\n",
        "    m = _par_changes(k)\n",
        "    m[\"step\"] = k\n",
        "    m[\"kind\"] = [_kind(o, n) for o, n in zip(m[\"PAR (NOR)_v1\"], m[\"PAR (NOR)\"])]\n",
        "    _allpar.append(m)\n",
        "allpar = pd.concat(_allpar, ignore_index=True)\n",
        "_ps = {k: {c: int((allpar[allpar[\"step\"] == k][\"kind\"] == c).sum())\n",
        "           for c in [\"new\", \"same\", \"wider\", \"narrower\", \"shifted\", \"none\"]} for k in PCR_OF}\n",
        "par_show = pd.DataFrame([[PCR_OF[k], T.STEP_NAME[k], sum(v.values()) - v[\"new\"], v[\"same\"],\n",
        "                          v[\"wider\"], v[\"narrower\"], v[\"shifted\"], v[\"none\"], v[\"new\"]]\n",
        "                         for k, v in _ps.items()],\n",
        "                        columns=[\"Report\", \"Step\", \"In Version 1.0\", \"Unchanged\",\n",
        "                                 \"Wider\", \"Narrower\", \"Moved\", \"No range\", \"New\"])\n",
        "for _c in [\"Moved\", \"No range\"]:\n",
        "    if par_show[_c].sum() == 0:\n",
        "        par_show = par_show.drop(columns=_c)\n",
        "n_par_same = int((allpar[\"kind\"] == \"same\").sum())\n",
        "n_par_wider = int((allpar[\"kind\"] == \"wider\").sum())\n",
        "n_par_narrow = int((allpar[\"kind\"] == \"narrower\").sum())\n",
        "n_par_moved = int((allpar[\"kind\"] == \"shifted\").sum())\n",
        "n_par_none = int((allpar[\"kind\"] == \"none\").sum())\n",
        "n_par_new = int((allpar[\"kind\"] == \"new\").sum())\n",
        "n_par_v1 = int((allpar[\"kind\"] != \"new\").sum())\n",
        "n_par_changed = n_par_wider + n_par_narrow + n_par_moved + n_par_none\n",
        "assert n_par_wider > n_par_changed / 2\n",
        "for _o, _n in zip(*[allpar[allpar[\"kind\"] == \"shifted\"][c] for c in [\"PAR (NOR)_v1\", \"PAR (NOR)\"]]):\n",
        "    _a, _b = _span(_o), _span(_n)           # \"moved\": one end inward, the other outward\n",
        "    assert (_b[0] < _a[0] and _b[1] < _a[1]) or (_b[0] > _a[0] and _b[1] > _a[1])\n",
        "assert bool(allpar[allpar[\"kind\"] == \"none\"][\"PAR (NOR)\"].str.contains(\"set-point\").all())                         # \"most of the changed ranges widened\"\n",
        "par_counts_phrase = (f\"{n_par_wider} are wider in the re-analysis\"\n",
        "                     + f\", {n_par_narrow} are narrower\"\n",
        "                     + (f\", {n_par_moved} have moved\" if n_par_moved else \"\")\n",
        "                     + (f\", {n_par_none} no longer give a range\" if n_par_none else \"\")\n",
        "                     + f\" and {n_par_same} are unchanged\")\n",
        "\n",
        "# which Version 1.0 rule each wider range was judged against\n",
        "_LBL2RESP = {}\n",
        "for _, r in r1.iterrows():\n",
        "    _LBL2RESP[(r[\"step_key\"], D.RESP_LABEL[r[\"response\"]])] = r[\"rule\"]\n",
        "def _v1rule(step, lbl):\n",
        "    r = _LBL2RESP.get((step, lbl))\n",
        "    return \"DS\" if r is None else T._rule_code(r)\n",
        "_wd = allpar[allpar[\"kind\"] == \"wider\"].copy()\n",
        "_wd[\"rule\"] = [_v1rule(s, l) for s, l in zip(_wd[\"step\"], _wd[\"CQA\"])]\n",
        "_wb = _wd[_wd[\"step\"] == \"bioreactor\"]\n",
        "brx_wider = len(_wb)\n",
        "brx_wider_glycan = int((_wb[\"rule\"] == \"R2\").sum())\n",
        "assert set(_wb[_wb[\"rule\"] == \"R2\"][\"CQA\"]) <= {\"Afucosylation\", \"Galactosylation\", \"High mannose\"}\n",
        "brx_wider_agg = int(((_wb[\"rule\"] == \"R1\") & _wb[\"CQA\"].str.startswith(\"Aggregates\")).sum())\n",
        "assert brx_wider == brx_wider_glycan + brx_wider_agg\n",
        "_wo = _wd[_wd[\"step\"] != \"bioreactor\"]\n",
        "n_wider_other = len(_wo)\n",
        "n_wider_other_r1 = int((_wo[\"rule\"] == \"R1\").sum())\n",
        "_wo4 = _wo[_wo[\"rule\"] == \"R4\"]\n",
        "n_wider_other_r4 = len(_wo4)\n",
        "_wods = _wo[_wo[\"rule\"] == \"DS\"]\n",
        "n_wider_other_ds = len(_wods)\n",
        "assert n_wider_other == n_wider_other_r1 + n_wider_other_r4 + n_wider_other_ds\n",
        "assert n_wider_other_r1 > n_wider_other / 2\n",
        "assert set(_wo4[\"step\"]) <= {\"virus_filtration\"}\n",
        "assert set(zip(_wods[\"step\"], _wods[\"CQA\"])) <= {(\"protein_a\", \"Leached Protein A (ppm)\")}\n",
        "def _n_ranges(n): return f\"{nw(n)} range\" + (\"\" if n == 1 else \"s\")\n",
        "_rest = []\n",
        "if n_wider_other_ds:\n",
        "    _rest.append(f\"{_n_ranges(n_wider_other_ds)} for leached Protein A at the Protein A step, which \"\n",
        "                 \"Version 1.0 judged against the drug-substance criterion itself,\")\n",
        "if n_wider_other_r4:\n",
        "    _rest.append(f\"{_n_ranges(n_wider_other_r4)} at virus filtration, where the Version 1.0 criterion \"\n",
        "                 \"(the fourth rule in §3.3) lay above the platform claim that replaced it\")\n",
        "wider_rest_phrase = (\"The remaining wider ranges are \" + \" and \".join(_rest) + \".\") if _rest else \"\"\n",
        "for _, r in r1[r1[\"step_key\"] == \"virus_filtration\"].iterrows():\n",
        "    assert r[\"low\"] > D.iac_limit(\"virus_filtration\", r[\"response\"])[0]\n",
        "\n",
        "def par_cell(key, cqa, param, rev):\n",
        "    t = D.par_table_rev1(key) if rev == 1 else D.par_table(key)\n",
        "    return t[(t[\"CQA\"] == cqa) & (t[\"Parameter\"] == param)].iloc[0][\"PAR (NOR)\"]\n",
        "\n",
        "cex_load_v1 = par_cell(\"cex\", \"Aggregates (HMW, %)\", \"Protein load\", 1)\n",
        "cex_load_v2 = par_cell(\"cex\", \"Aggregates (HMW, %)\", \"Protein load\", 2)\n",
        "cex_load_nor = CFG.unit_op(\"cex\").param(\"load\").nor\n",
        "assert _span(cex_load_v1)[1] < cex_load_nor[1] <= _span(cex_load_v2)[1]\n",
        "brx_gal_v1 = par_cell(\"bioreactor\", \"Galactosylation\", \"Dissolved CO2 (pCO2)\", 1)\n",
        "brx_co2_nor = CFG.unit_op(\"bioreactor\").param(\"co2\").nor\n",
        "brx_gal_v2 = par_cell(\"bioreactor\", \"Galactosylation\", \"Dissolved CO2 (pCO2)\", 2)\n",
        "assert _span(brx_gal_v1)[0] > brx_co2_nor[0] >= _span(brx_gal_v2)[0]\n",
        "\n",
        "# acidic variants at the bioreactor: the ranges that changed, and what constrains them\n",
        "_ba = allpar[(allpar[\"step\"] == \"bioreactor\") & (allpar[\"CQA\"] == \"Acidic variants\")]\n",
        "brx_acid_changed = int(_ba[\"kind\"].isin([\"wider\", \"narrower\", \"shifted\", \"none\"]).sum())\n",
        "brx_acid_wider = int((_ba[\"kind\"] == \"wider\").sum())\n",
        "brx_acid_narrow = int((_ba[\"kind\"] == \"narrower\").sum())\n",
        "brx_acid_moved = int((_ba[\"kind\"] == \"shifted\").sum())\n",
        "assert brx_acid_changed == _ps[\"bioreactor\"][\"narrower\"] + _ps[\"bioreactor\"][\"shifted\"]\n",
        "_brx_r1 = r1[r1[\"step_key\"] == \"bioreactor\"].set_index(\"response\")\n",
        "_brx_v2 = _iac[_iac[\"step_key\"] == \"bioreactor\"].set_index(\"response\")\n",
        "_brx_tighter = [x for x in _brx_r1.index if _brx_v2.loc[x, \"iac_high\"] < _brx_r1.loc[x, \"high\"]\n",
        "                or _brx_v2.loc[x, \"iac_low\"] > _brx_r1.loc[x, \"low\"]]\n",
        "# the only stricter bioreactor limit is the acidic variant floor, which Version 1.0 did not apply\n",
        "assert _brx_tighter == [\"acidic_variants\"]\n",
        "assert _brx_r1.loc[\"acidic_variants\", \"low\"] == 0 and _brx_v2.loc[\"acidic_variants\", \"iac_high\"] >= _brx_r1.loc[\"acidic_variants\", \"high\"]\n",
        "# judged against the upper limit alone, every acidic variant range would span the whole range\n",
        "_ea = D.effective_acceptance\n",
        "try:\n",
        "    D.effective_acceptance = lambda k, r: ((lambda a: (a[0], a[1], \"upper\"))(_ea(k, r))\n",
        "                                           if (k, r) == (\"bioreactor\", \"acidic_variants\") else _ea(k, r))\n",
        "    for _f in D.rsm_factors(\"bioreactor\"):\n",
        "        _p = D.par_nor_propagated(\"bioreactor\", \"acidic_variants\", _f)[\"par_nat\"]\n",
        "        _pr = CFG.unit_op(\"bioreactor\").param(_f).prange\n",
        "        assert _p is not None and abs(_p[0] - _pr[0]) < 1e-9 and abs(_p[1] - _pr[1]) < 1e-9\n",
        "finally:\n",
        "    D.effective_acceptance = _ea\n",
        "brx_acid_phrase = (f\"{nw(brx_acid_narrow)} narrowed, {nw(brx_acid_moved)} moved and \"\n",
        "                   + (\"none widened\" if brx_acid_wider == 0 else f\"{nw(brx_acid_wider)} widened\"))\n",
        "_nw = allpar[allpar[\"kind\"].isin([\"narrower\", \"shifted\", \"none\"])]\n",
        "assert set(_nw[\"step\"]) == {\"bioreactor\", \"viral_inactivation\", \"aex\"}\n",
        "assert set(_nw[_nw[\"step\"] == \"bioreactor\"][\"CQA\"]) == {\"Acidic variants\"}\n",
        "assert set(_nw[_nw[\"step\"] == \"viral_inactivation\"][\"CQA\"]) == {\"XMuLV LRF (log₁₀)\"}\n",
        "\n",
        "# viral clearance ranges at low-pH viral inactivation and anion exchange\n",
        "_vi = allpar[allpar[\"step\"] == \"viral_inactivation\"]\n",
        "_vix = _vi[_vi[\"CQA\"].str.startswith(\"XMuLV\")]\n",
        "n_vi_factors = len(_vix)\n",
        "n_vi_none = int((_vix[\"kind\"] == \"none\").sum())\n",
        "assert n_vi_none == _ps[\"viral_inactivation\"][\"none\"]\n",
        "vi_none_phrase = (f\"for any of its {nw(n_vi_factors)} parameters\" if n_vi_none == n_vi_factors\n",
        "                  else f\"for {nw(n_vi_none)} of its {nw(n_vi_factors)} parameters\")\n",
        "vi_ph_v1 = par_cell(\"viral_inactivation\", \"XMuLV LRF (log₁₀)\", \"Inactivation pH\", 1)\n",
        "vi_xm_v1 = _r1(\"viral_inactivation\", \"xmulv_lrf\")[\"low\"]\n",
        "vi_xm_v2 = D.iac_limit(\"viral_inactivation\", \"xmulv_lrf\")[0]\n",
        "assert vi_xm_v2 > vi_xm_v1\n",
        "_an = allpar[(allpar[\"step\"] == \"aex\") & (allpar[\"kind\"] == \"narrower\")]\n",
        "assert len(_an) == _ps[\"aex\"][\"narrower\"] and bool(_an[\"CQA\"].str.contains(\"LRF\").all())\n",
        "assert set(_an[\"Parameter\"]) == {\"Load pH\"}\n",
        "aex_narrow_txt = \" and \".join(f\"{l.split(' ')[0]} from {o} to {n}\" for l, o, n in\n",
        "                              zip(_an[\"CQA\"], _an[\"PAR (NOR)_v1\"], _an[\"PAR (NOR)\"]))\n",
        "assert all(_r1(\"aex\", r)[\"low\"] < D.iac_limit(\"aex\", r)[0] for r in [\"xmulv_lrf\", \"mvm_lrf\"])\n",
        "\n",
        "# CAPA and effectiveness check, from config campaign.capa\n",
        "capa_md = CAPA.rename(columns={\"id\": \"No.\", \"action\": \"Action\", \"owner\": \"Owner function\",\n",
        "                               \"due\": \"Due\", \"status\": \"Status\"})\n",
        "_ca = CAPA[CAPA[\"id\"].str.startswith(\"CA\")]\n",
        "_pa = CAPA[CAPA[\"id\"].str.startswith(\"PA\")]\n",
        "ca_open_due = _ca[\"due\"].max()\n",
        "assert ca_open_due == REV2_DATE\n",
        "n_capa = len(CAPA)\n",
        "assert bool((CAPA[\"status\"] == \"open at closure\").all())\n",
        "pa_due_max = _pa[\"due\"].max()\n",
        "eff_due, eff_crit = EFFECTIVENESS[\"due\"], EFFECTIVENESS[\"criterion\"]\n",
        "\n",
        "# capability thresholds stated in PCMP-001 Version 2.0\n",
        "_below = capdf[capdf[\"Cpk\"] < CPK_TARGET]\n",
        "n_below_target = len(_below)\n",
        "all_meet_min = bool((capdf[\"Cpk\"] >= CPK_MIN).all())\n",
        "_below_names = \" and \".join(aname(k) for k in _below.index)\n",
        "thr_sentence = ((f\"Only the capability index of {_below_names} falls below the target\" if n_below_target == 1\n",
        "                 else f\"The capability indices of {_below_names} fall below the target\") if n_below_target\n",
        "                else \"Every attribute meets the target\") + (\n",
        "    \", and every attribute meets the minimum.\" if all_meet_min else\n",
        "    \", and at least one attribute falls below the minimum.\")\n",
        "\n",
        "# each re-analysed pool attribute and clearance result against its Version 2.0 criterion over the\n",
        "# NOR, at manufacturing scale, on the response-surface model (one basis for Tables 6.4 and 6.5)\n",
        "def _lf_txt(k, combo):\n",
        "    \"\"\"The least favourable NOR combination, written out: 'inactivation pH at its NOR high (3.6)'.\"\"\"\n",
        "    uo = CFG.unit_op(k)\n",
        "    parts = []\n",
        "    for f, v in combo.items():\n",
        "        p = uo.param(f)\n",
        "        where = \"NOR low\" if v == p.nor[0] else \"NOR high\" if v == p.nor[1] else \"set-point\"\n",
        "        u = \"\" if p.unit == \"pH\" else f\" {p.unit}\"\n",
        "        parts.append(f\"{lc(p.name)} at its {where} ({v:g}{u})\")\n",
        "    return \", \".join(parts[:-1]) + \" and \" + parts[-1] if len(parts) > 1 else parts[0]\n",
        "\n",
        "_res = []\n",
        "for _, r in _iac.iterrows():\n",
        "    k, resp = r[\"step_key\"], r[\"response\"]\n",
        "    uo = CFG.unit_op(k)\n",
        "    fac = D.fit(k, \"rsm\", resp)[\"factors\"]\n",
        "    grid = list(itertools.product(*[[uo.param(f).nor[0], uo.param(f).setpoint, uo.param(f).nor[1]] for f in fac]))\n",
        "    nat = {f: [g[i] for g in grid] for i, f in enumerate(fac)}\n",
        "    spn = {f: [uo.param(f).setpoint] for f in fac}\n",
        "    _o = D.sdm_offset(k, resp)\n",
        "    off = 0.0 if _o is None else _o[\"offset\"]\n",
        "    stat = D.decision_statistic(resp)\n",
        "    mean = np.asarray(D.predict(k, resp, natural=nat), float) - off\n",
        "    sp = float(D.predict(k, resp, natural=spn)[0]) - off\n",
        "    lo_c, hi_c, st = r[\"iac_low\"], r[\"iac_high\"], r[\"spec_type\"]\n",
        "    if stat == \"batch\":\n",
        "        _, plo, phi = D.prediction_interval(k, resp, nat)\n",
        "        lo_v, hi_v = float(plo.min()) - off, float(phi.max()) - off\n",
        "        _, splo, sphi = D.prediction_interval(k, resp, spn)\n",
        "        sp_ok = _in(float(splo[0]) - off, lo_c, hi_c, st) and _in(float(sphi[0]) - off, lo_c, hi_c, st)\n",
        "        i_bad = int(np.argmin(plo)) if not _in(lo_v, lo_c, hi_c, st) else int(np.argmax(phi))\n",
        "    else:\n",
        "        assert st == \"lower\"\n",
        "        lo_v, hi_v = float(mean.min()), float(mean.max())\n",
        "        sp_ok = _in(sp, lo_c, hi_c, st)\n",
        "        i_bad = int(np.argmin(mean))\n",
        "    ok = D.nor_met(k, resp)\n",
        "    assert ok == (_in(lo_v, lo_c, hi_c, st) and _in(hi_v, lo_c, hi_c, st)), (k, resp)\n",
        "    _res.append(dict(step=k, cqa=r[\"cqa\"], resp=resp, crit=T.crit(lo_c, hi_c, st), stat=stat,\n",
        "                     sp=sp, lo=lo_v, hi=hi_v, ok=ok, sp_ok=sp_ok, off=off,\n",
        "                     lo_c=lo_c, hi_c=hi_c, st=st, corner=dict(zip(fac, grid[i_bad]))))\n",
        "res_df = pd.DataFrame(_res)\n",
        "qa_df = res_df[res_df[\"stat\"] == \"batch\"].reset_index(drop=True)\n",
        "vir_df = res_df[res_df[\"stat\"] == \"worst_case\"].reset_index(drop=True)\n",
        "assert set(vir_df[\"cqa\"]) <= {\"lrv_xmulv\", \"lrv_mvm\"} and len(vir_df) == n_iac_claim\n",
        "res_show = pd.DataFrame({\n",
        "    \"Step\": [T.STEP_NAME[s] for s in qa_df[\"step\"]],\n",
        "    \"Attribute\": [T.ATTR_NAME[c] for c in qa_df[\"cqa\"]],\n",
        "    \"Criterion\": qa_df[\"crit\"],\n",
        "    \"Mean at set-points\": [T.num(x) for x in qa_df[\"sp\"]],\n",
        "    \"95 % prediction interval over the NOR\": [f\"{T.num(a)} to {T.num(b)}\" for a, b in zip(qa_df[\"lo\"], qa_df[\"hi\"])],\n",
        "    \"Met\": [\"Met\" if o else \"Not met\" for o in qa_df[\"ok\"]],\n",
        "})\n",
        "viral_show = pd.DataFrame({\n",
        "    \"Step\": [T.STEP_NAME[s] for s in vir_df[\"step\"]],\n",
        "    \"Virus\": [\"XMuLV\" if c == \"lrv_xmulv\" else \"MVM\" for c in vir_df[\"cqa\"]],\n",
        "    \"Claim\": [f\"≥ {x:g}\" for x in vir_df[\"lo_c\"]],\n",
        "    \"At set-points\": [f2(x) for x in vir_df[\"sp\"]],\n",
        "    \"At least favourable combination\": [f2(x) for x in vir_df[\"lo\"]],\n",
        "    \"Met\": [\"Met\" if o else \"Not met\" for o in vir_df[\"ok\"]],\n",
        "})\n",
        "n_qa, n_qa_met = len(qa_df), int(qa_df[\"ok\"].sum())\n",
        "n_vir, n_vir_met = len(vir_df), int(vir_df[\"ok\"].sum())\n",
        "n_vir_sp_met = int(vir_df[\"sp_ok\"].sum())\n",
        "n_res, n_res_met = len(res_df), int(res_df[\"ok\"].sum())\n",
        "n_res_not = n_res - n_res_met\n",
        "_nm = res_df[~res_df[\"ok\"]]\n",
        "assert bool(_nm[\"sp_ok\"].all())                      # each not-met result is met with every parameter at its set-point\n",
        "def _nm_name(r): return f\"{aname(r['cqa'])} at the {sname(r['step'])} step\"\n",
        "nm_list = \" and \".join(_nm_name(r) for _, r in _nm.iterrows())\n",
        "_qnm = qa_df[~qa_df[\"ok\"]]\n",
        "def _qnm_desc(r):\n",
        "    u = unit(r[\"cqa\"]); us = \" %\" if u == \"%\" else f\" {u}\"\n",
        "    low_side = not _in(r[\"lo\"], r[\"lo_c\"], r[\"hi_c\"], r[\"st\"])\n",
        "    val, lim = (r[\"lo\"], r[\"lo_c\"]) if low_side else (r[\"hi\"], r[\"hi_c\"])\n",
        "    side = \"lower\" if low_side else \"upper\"\n",
        "    return (f\"For {_nm_name(r)}, the {side} 95 % prediction limit for a single batch reaches \"\n",
        "            f\"{T.num(val)}{us} at {_lf_txt(r['step'], r['corner'])}, against the {side} limit of \"\n",
        "            f\"{T.num(lim)}{us}. With every parameter at its set-point the batch interval meets the criterion.\")\n",
        "qa_phrase = (f\"Every one of the {n_qa} pool attributes meets its criterion across the NOR.\" if len(_qnm) == 0 else\n",
        "             f\"Of the {n_qa} pool attributes, {n_qa_met} meet their criterion across the NOR. \"\n",
        "             + \" \".join(_qnm_desc(r) for _, r in _qnm.iterrows()))\n",
        "\n",
        "# acidic variants at the bioreactor: which proven acceptable range no longer covers its NOR, and why\n",
        "assert set(_qnm[\"cqa\"]) <= {\"acidic_variants\"} and set(_qnm[\"step\"]) <= {\"bioreactor\"}\n",
        "_bpt = D.par_table(\"bioreactor\")\n",
        "_bpa = _bpt[_bpt[\"CQA\"] == \"Acidic variants\"]\n",
        "_unc = []\n",
        "for _, r in _bpa.iterrows():\n",
        "    f = [x for x in D.rsm_factors(\"bioreactor\") if CFG.unit_op(\"bioreactor\").param(x).name == r[\"Parameter\"]][0]\n",
        "    p = CFG.unit_op(\"bioreactor\").param(f)\n",
        "    a, b = _span(r[\"PAR (NOR)\"])\n",
        "    if a > p.nor[0] or b < p.nor[1]:\n",
        "        _unc.append((f, p, a, b, r[\"Unit\"]))\n",
        "assert len(_unc) == 1\n",
        "_uf, _up, _ua, _ub, _uu = _unc[0]\n",
        "acid_unc_name, acid_unc_par = lc(_up.name), f\"{_ua:g}–{_ub:g}\"\n",
        "acid_unc_unit, acid_unc_nor_hi = _uu, _up.nor[1]\n",
        "assert _ub < _up.nor[1] and _ua <= _up.nor[0]           # the range stops short of the upper NOR edge\n",
        "_acoef = D.rsm_coeff_df(\"bioreactor\", \"acidic_variants\").set_index(\"Term\")[\"Coef.\"]\n",
        "acid_unc_coef = float(_acoef[D.factor_letters(\"bioreactor\")[_uf]])\n",
        "assert acid_unc_coef < 0                                # acidic variants fall as this parameter rises\n",
        "\n",
        "# XMuLV clearance of low-pH viral inactivation at the least favourable combination\n",
        "_rx = vir_df[(vir_df[\"step\"] == \"viral_inactivation\") & (vir_df[\"cqa\"] == \"lrv_xmulv\")].iloc[0]\n",
        "vi_xm_worst, vi_xm_sp, vi_xm_ok = _rx[\"lo\"], _rx[\"sp\"], bool(_rx[\"ok\"])\n",
        "assert not vi_xm_ok and _rx[\"sp_ok\"]\n",
        "vi_corner_txt = _lf_txt(\"viral_inactivation\", _rx[\"corner\"])\n",
        "vir_phrase = ((f\"With every parameter at its set-point, every one of the {n_vir} claims is met.\"\n",
        "               if n_vir_sp_met == n_vir else\n",
        "               f\"With every parameter at its set-point, {n_vir_sp_met} of the {n_vir} claims are met.\")\n",
        "              + (f\" At the least favourable combination, every claim is met.\" if n_vir_met == n_vir else\n",
        "                 f\" At the least favourable combination, {n_vir_met} of the {n_vir} claims are met.\"))\n",
        "\n",
        "# leached Protein A at the capture step, judged per batch at manufacturing scale\n",
        "_rl = qa_df[(qa_df[\"step\"] == \"protein_a\") & (qa_df[\"cqa\"] == \"leached_protein_a\")].iloc[0]\n",
        "lpa_sp, lpa_hi, lpa_crit = _rl[\"sp\"], _rl[\"hi\"], _rl[\"hi_c\"]\n",
        "ds_lpa = _ds(\"leached_protein_a\", \"ds_high\")\n",
        "assert bool(_rl[\"ok\"]) and lpa_hi > ds_lpa\n",
        "lpa_need = lpa_hi / ds_lpa                               # downstream clearance the batch needs\n",
        "lpa_assumed = float(_iac[(_iac[\"step_key\"] == \"protein_a\") & (_iac[\"cqa\"] == \"leached_protein_a\")].iloc[0][\"downstream_fold\"])\n",
        "assert lpa_need < lpa_assumed\n",
        "_lv = ver[ver[\"cqa\"] == \"leached_protein_a\"]\n",
        "assert len(_lv) == 2 and bool(_lv[\"met\"].isna().all())\n",
        "\n",
        "# Protein A pool host cell protein: the pool attribute nearest its criterion, and what moves it\n",
        "_pq = qa_df[qa_df[\"step\"] == \"protein_a\"].copy()\n",
        "_pq[\"use\"] = _pq[\"hi\"] / _pq[\"hi_c\"]\n",
        "assert _pq.sort_values(\"use\").iloc[-1][\"cqa\"] == \"hcp\"\n",
        "pa_hcp_use = 100 * float(_pq.set_index(\"cqa\").loc[\"hcp\", \"use\"])\n",
        "_hc = D.rsm_coeff_df(\"protein_a\", \"pool_hcp_ng_mg\").set_index(\"Term\")[\"Coef.\"]\n",
        "_hl = D.factor_letters(\"protein_a\")\n",
        "_mains = sorted(((abs(float(_hc[_hl[f]])), f, float(_hc[_hl[f]])) for f in D.rsm_factors(\"protein_a\")),\n",
        "                reverse=True)[:2]\n",
        "pa_hcp_drivers = \" and \".join((\"higher \" if c > 0 else \"lower \") + lc(CFG.unit_op(\"protein_a\").param(f).name)\n",
        "                              for _, f, c in _mains)\n",
        "\n",
        "# the tightened aggregate criteria: did any proven acceptable range at those steps stop short?\n",
        "def _full(key, lbl_prefix):\n",
        "    t = D.par_table(key)\n",
        "    t = t[t[\"CQA\"].str.startswith(lbl_prefix)]\n",
        "    return all(_span(a) == _span(b) for a, b in zip(t[\"PAR (NOR)\"], t[\"Char. range\"]))\n",
        "tight_full = all(_full(k, \"Aggregates\") for k in _tt[\"step_key\"])\n",
        "tight_phrase = (\"Against the tightened criteria, every aggregate proven acceptable range at these two steps \"\n",
        "                \"still spans the whole characterization range, so the tightening moved no range.\"\n",
        "                if tight_full else\n",
        "                \"Against the tightened criteria, at least one aggregate proven acceptable range at these steps \"\n",
        "                \"no longer spans the whole characterization range.\")\n",
        "\n",
        "# the bioreactor aggregate criterion, both tightened and widened\n",
        "_both = _iac[_is_t & _is_w]\n",
        "n_both = len(_both)\n",
        "both_txt = \" and \".join(f\"{aname(c)} at the {sname(s)} step\" for s, c in zip(_both[\"step_key\"], _both[\"cqa\"]))\n",
        "assert n_both == 1 and _both.iloc[0][\"step_key\"] == \"bioreactor\" and _both.iloc[0][\"cqa\"] == \"aggregates_hmw\"\n",
        "_vagg = ver[(ver[\"step_key\"] == \"viral_inactivation\") & (ver[\"cqa\"] == \"aggregates_hmw\")].iloc[0]\n",
        "assert bool(_vagg[\"widening_supported\"])\n",
        "vi_agg_assumed, vi_agg_bound = _vagg[\"assumed\"], _vagg[\"predicted_nor_bound95\"]\n",
        "cex_agg_bound = _vx[\"predicted_nor_bound95\"]\n",
        "assert cex_agg_bound < cex_agg_assumed\n",
        "\n",
        "# \"No range\" rows are all viral clearance, judged at the least favourable combination\n",
        "assert bool(allpar[allpar[\"kind\"] == \"none\"][\"CQA\"].str.contains(\"LRF\").all())\n",
        "\n",
        "# the SEC excess against the Protein A fragment criterion\n",
        "pa_frag_crit = D.iac_limit(\"protein_a\", \"lmw_cesds_pct\")[1]\n",
        "sec_share_crit = 100 * d_pa / pa_frag_crit\n",
        "\n",
        "# acidic variants capability: distance of the mean from each limit, in SD\n",
        "acid_z_lo, acid_z_hi = (acid_mean - ds_acid_lo) / acid_sd, (ds_acid_hi - acid_mean) / acid_sd\n",
        "assert acid_z_lo < acid_z_hi\n",
        "\n",
        "# offset qualification of the Protein A model, per output with a criterion, on both run sets\n",
        "_q_plan = T.sdm_offsets_data([\"protein_a\"], studies=_sdm_planned_ids)\n",
        "_q_all = T.sdm_offsets_data([\"protein_a\"])\n",
        "_qj = _q_plan[_q_plan[\"judged\"]][\"output\"].tolist()\n",
        "def _oname(o):\n",
        "    n = T.SDM_OUTPUT[o][0]\n",
        "    return n.replace(\"Leached\", \"leached\") if n.startswith(\"Leached\") else lc(n)\n",
        "_qp, _qa = _q_plan.set_index(\"output\"), _q_all.set_index(\"output\")\n",
        "_sent = []\n",
        "for o in _qj:\n",
        "    a, b = bool(_qp.loc[o, \"qualified\"]), bool(_qa.loc[o, \"qualified\"])\n",
        "    if a and b:\n",
        "        _sent.append(f\"For {_oname(o)} the model is qualified on the planned runs alone and on all runs.\")\n",
        "    elif not a and not b:\n",
        "        ends = [e for e, k in [(\"low\", \"met_lo\"), (\"high\", \"met_hi\")] if _qa.loc[o, k] != _qa.loc[o, \"met_point\"]]\n",
        "        _sent.append(f\"For {_oname(o)} the model is not qualified on either set of runs. With the offset at the \"\n",
        "                     f\"{' and '.join(ends)} end of its interval, the conclusion against the criterion over the NOR \"\n",
        "                     \"differs from the conclusion at the estimate.\")\n",
        "    else:\n",
        "        _sent.append(f\"For {_oname(o)} the model is qualified on {'the planned runs alone' if a else 'all runs'} only.\")\n",
        "sdm_q_phrase = \" \".join(_sent)\n",
        "# the NORs that PCR-005 and PCR-006 Version 2.0 narrow, from the findings at the characterized NOR\n",
        "def _narrowed(k):\n",
        "    raw = {q[\"key\"]: q for q in CFG.raw()[\"process\"][k][\"parameters\"]}\n",
        "    return [f for f in D.rsm_factors(k) if \"nor_v2\" in raw[f] and list(raw[f][\"nor_v2\"]) != list(raw[f][\"nor\"])]\n",
        "pa_narrowed, vi_narrowed = _narrowed(\"protein_a\"), _narrowed(\"viral_inactivation\")\n",
        "assert pa_narrowed and vi_narrowed\n",
        "assert not bool(_qa.loc[\"pool_hcp_ng_mg\", \"qualified\"])         # the reason PCR-005 narrows its NOR\n",
        "pa_narrow_phrase = (\"Because the model is not qualified for host cell protein at the NOR as characterized, \"\n",
        "                    \"the Protein A report PCR-005 Version 2.0 narrows the NOR of \"\n",
        "                    + \" and \".join(lc(CFG.unit_op(\"protein_a\").param(f).name) for f in pa_narrowed) + \".\")\n",
        "\n",
        "# data the re-analysis adds to those Version 1.0 reported\n",
        "_retest_ids = [s for s in chron[\"id\"] if s.endswith(\"-RET\")]\n",
        "retest_txt = \" and \".join(_retest_ids)\n",
        "\n",
        "# Version 1.0 alert-limit ranges at the bioreactor that stopped short of the NOR (finding F3)\n",
        "_r2 = allpar[(allpar[\"step\"] == \"bioreactor\") & allpar[\"CQA\"].isin([\"Afucosylation\", \"Galactosylation\", \"High mannose\"])]\n",
        "_short = 0\n",
        "for _, r in _r2.iterrows():\n",
        "    f = [x for x in D.rsm_factors(\"bioreactor\") if CFG.unit_op(\"bioreactor\").param(x).name == r[\"Parameter\"]][0]\n",
        "    p = CFG.unit_op(\"bioreactor\").param(f); a, b = _span(r[\"PAR (NOR)_v1\"])\n",
        "    _short += int(a > p.nor[0] or b < p.nor[1])\n",
        "assert _short >= 2                                       # \"several\" stopped short of the NOR\n",
        "par_align = [\"l\", \"P{3.4cm}\"] + [\"r\"] * (par_show.shape[1] - 2)\n",
        "par_notes = [n for n, c in [((\"a)\", \"One end of the range moved inward and the other outward.\"), \"Moved\"),\n",
        "                            ((\"b)\", \"With the other parameters at their least favourable combination of NOR low, set-point and NOR high, the viral clearance claim is not met even with the scanned parameter at its set-point.\"), \"No range\"),\n",
        "                            ((\"c)\", \"Fragment ranges measured by nrCE-SDS, which Version 1.0 did not report.\"), \"New\")]\n",
        "             if c in par_show.columns]\n",
        "_CN.__exit__(None, None, None)"
      ],
      "id": "c95dd8d1",
      "execution_count": null,
      "outputs": []
    },
